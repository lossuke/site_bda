---
import { Image } from 'astro:assets';
import BdaImage from '../assets/logo.jpg';
import ExhibitionImage from '../assets/adresses/ad3.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

// Remplace les deux images importées ci-dessus pour personnaliser la page.
const instagramUrl = 'https://www.instagram.com/bda_telecomparis/';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Contact | Bureau des Arts et Cultures de Télécom Paris"
			description="Une question, une idée ou un projet ? Contacte le Bureau des Arts et Cultures de Télécom Paris."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-heading">
				<h1>Contact</h1>
				<p>Une question, une idée, un projet ? Échangeons.</p>
			</div>

			<!-- Première section : image à gauche, texte à droite. -->
			<section class="contact-section" aria-labelledby="contact-title">
				<div class="contact-visual contact-visual--logo">
					<Image
						src={BdaImage}
						alt="Logo du Bureau des Arts et Cultures de Télécom Paris"
						width={600}
						height={600}
						loading="eager"
					/>
				</div>
				<div class="contact-text">
					<h2 id="contact-title">Écris-nous !</h2>
					<p>
						Tu souhaites en savoir plus sur le Bureau des Arts et Cultures de Télécom Paris,
						participer à la vie du BDA ou simplement nous poser une question ?
					</p>
					<p>Retrouve-nous sur Instagram pour échanger avec nous.</p>
					<a class="contact-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">
						Nous écrire sur Instagram <span aria-hidden="true">↗</span>
						<span class="sr-only"> (nouvel onglet)</span>
					</a>
					<p class="instagram-handle">@bda_telecomparis</p>
				</div>
			</section>

			<!-- La classe « contact-section--reverse » place l'image à droite. -->
			<section class="contact-section contact-section--reverse" aria-labelledby="project-title">
				<div class="contact-visual">
					<Image
						src={ExhibitionImage}
						alt="Des tableaux exposés dans une galerie lumineuse"
						width={800}
						height={640}
						fit="cover"
						loading="lazy"
					/>
				</div>
				<div class="contact-text">
					<h2 id="project-title">Une idée à partager ?</h2>
					<p>
						Un événement, une exposition, une collaboration… Si tu as une envie ou un projet
						culturel en tête, parlons-en ensemble !
					</p>
					<p>
						Pour découvrir les nouvelles du BDA et trouver un peu d'inspiration, tu peux aussi
						parcourir nos actualités.
					</p>
					<a class="text-link" href="/Actu/">Voir les actualités <span aria-hidden="true">→</span></a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		box-sizing: border-box;
		width: min(1120px, calc(100% - 3rem));
		max-width: none;
		margin: 0 auto;
		padding: 3.5rem 0 5rem;
	}

	main :global(*) {
		text-align: left;
	}

	.page-heading {
		margin-bottom: 3rem;
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
	}

	.page-heading p {
		margin: 0.75rem 0 0;
		color: rgb(var(--gray-dark));
	}

	.contact-section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 5rem);
	}

	.contact-section + .contact-section {
		margin-top: clamp(3rem, 7vw, 6rem);
	}

	.contact-section--reverse {
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
	}

	.contact-section--reverse .contact-visual {
		grid-column: 2;
		grid-row: 1;
	}

	.contact-section--reverse .contact-text {
		grid-column: 1;
		grid-row: 1;
	}

	.contact-visual {
		overflow: hidden;
		border-radius: 12px;
	}

	.contact-visual :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		border-radius: 0;
	}

	.contact-visual--logo :global(img) {
		aspect-ratio: 1;
		object-fit: contain;
	}

	h2 {
		margin-bottom: 1.25rem;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
	}

	.contact-text p {
		margin: 0 0 1.25rem;
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		border: 2px solid var(--accent);
		border-radius: 6px;
		background: var(--accent);
		color: white;
		font-weight: 700;
		line-height: 1.4;
		text-decoration: none;
	}

	.contact-link:hover {
		background: white;
		color: var(--accent);
	}

	.contact-text .instagram-handle {
		margin: 0.75rem 0 0;
		font-size: 0.9em;
	}

	.text-link {
		font-weight: 700;
		text-underline-offset: 0.25em;
	}

	a:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 5px;
	}

	@media (max-width: 720px) {
		main {
			width: calc(100% - 2rem);
			padding: 2.5rem 0 3rem;
		}

		.page-heading {
			margin-bottom: 2rem;
		}

		.contact-section {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.75rem;
		}

		.contact-section--reverse .contact-visual,
		.contact-section--reverse .contact-text {
			grid-column: auto;
			grid-row: auto;
		}

		.contact-visual--logo {
			width: min(100%, 360px);
			margin-inline: auto;
		}
	}
</style>
