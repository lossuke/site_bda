---

import { SITE_TITLE , Titre } from '../consts';
import HeaderLink from './HeaderLink.astro';
import insta from '../assets/insta.svg';
import logo from '../assets/logo.svg';
import Image from 'astro/components/Image.astro';



---

<header>
	<nav>
		<h2><a href="/">{Titre}</a></h2>
		<a href="/" class="">
		<Image src={logo}
		alt="logo du BDA"
		height={50} />
		</a>

		<div class="internal-links">
			<HeaderLink href="/">Accueil</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/Actu">Actualités</HeaderLink>
			<HeaderLink href="/Actu">Contact</HeaderLink>

		</div>
		<div class="social-links">
			<a href="https://www.instagram.com/bda_telecomparis/" target="_blank">
			<Image src={insta} 
			alt="logo instagram"
			height={50}
			/></a>
				<span class="sr-only">suivre le BDA sur instagram</span>
			
			
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
