---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizePath = (path: string) => path.replace(/^\/+|\/+$/g, '').toLowerCase();
const pathname = normalizePath(Astro.url.pathname.replace(import.meta.env.BASE_URL, ''));
const linkPath = typeof href === 'string' ? normalizePath(href) : undefined;
const isActive = linkPath !== undefined &&
	(pathname === linkPath || (linkPath !== '' && pathname.startsWith(linkPath + '/')));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
